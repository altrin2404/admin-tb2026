generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Registration {
  id                 String    @id @default(cuid())
  teamId             String?
  teamName           String?
  name               String
  email              String
  phone              String
  department         String?
  year               String?
  college            String
  event1             String?
  event2             String?
  technicalEvents    String?
  nonTechnicalEvents String?
  paymentUtr         String?
  amount             Int?
  isVerified         Boolean   @default(false)
  isEntered          Boolean   @default(false)
  enteredAt          DateTime?
  entryNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Registration {
  id                 String    @id @default(cuid())
  participantNumber  Int?      @unique @default(autoincrement())
  participantId      String?   @unique
  teamId             String?
  teamName           String?
  name               String
  email              String
  phone              String
  department         String?
  year               String?
  college            String
  event1             String?
  event2             String?
  technicalEvents    String?
  nonTechnicalEvents String?
  paymentUtr         String?
  amount             Int?
  paymentStatus      String    @default("INITIALIZED")
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  isVerified         Boolean   @default(false)
  isEntered          Boolean   @default(false)
  enteredAt          DateTime?
  entryNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
